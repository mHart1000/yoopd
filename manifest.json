{
  "manifest_version": 3,
  "name": "Yoopd",
  "version": "1.0",
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "exclude_matches": [
      "*://*.ebay.com/*",
      "*://*.ebay.co.uk/*",
      "*://*.ebay.de/*",
      "*://*.ebay.com.au/*",
      "*://*.ebay.ca/*"
    ],
    "all_frames": true,
    "js": ["content.js"]
  }],
  "action": {
    "default_icon": "icons/play48.png"
  }
}
